# DoChess API — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.

# ── Required for production ────────────────────────────────────────────
# MongoDB Atlas connection string (Database → Connect → Drivers).
# Free tier (M0) is enough to start. Example shape, not a real credential:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=dochess

# Clerk secret key (Dashboard → API keys → Secret key, starts with sk_).
# The publishable key already lives in clerk-config.js and is public by design.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ── Optional ───────────────────────────────────────────────────────────
# Port/host for `npm run serve`. Bind 0.0.0.0 behind a reverse proxy.
PORT=8787
HOST=127.0.0.1

# Front-end origin during local development only (production is same-origin).
CORS_ORIGIN=

# Hard cap on request bodies (bytes).
MAX_BODY_BYTES=1500000

# ── Development only (never set in production) ─────────────────────────
# DOCHESS_DEV_NO_AUTH=1   → accept x-doChess-user header instead of Clerk.
# DOCHESS_DEV_FILE_STORE=0 → refuse the file fallback when Mongo is missing.
DOCHESS_DEV_NO_AUTH=0
DOCHESS_DEV_FILE_STORE=1
